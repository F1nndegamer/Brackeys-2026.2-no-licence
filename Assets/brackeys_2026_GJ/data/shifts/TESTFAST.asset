%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3820a889af54473ab2fe3ae78629eb1, type: 3}
  m_Name: TESTFAST
  m_EditorClassIdentifier: Assembly-CSharp::EnclosureShiftDefinition
  shiftTitle: TRUST NO MONKEY
  briefing: Keep the monkeys fed, calm and clean. Catch each culprit to grow your
    daycare. One wrong accusation ends the run.
  startingMonkeyCount: 6
  firstIncidentTimeSeconds: 5
  incidentIntervalSeconds: 10
  lineupSize: 4
  guessesPerIncident: 1
  incidentWindowSeconds: 5
  feedCooldownSeconds: 1
  fullHungerHoldSeconds: 20
  timeoutDurationSeconds: 30
  justifiedTimeoutNaughtiness: 2
  justifiedTimeoutTrustPenalty: 10
  unfairTimeoutTrustPenalty: 30
  maxMonkeysInTimeOut: 2
  recentTroubleWindowSeconds: 10
  baseNaughtinessPerSecond: 0.05
  populationPressurePerExtraMonkey: 0.12
  solvedIncidentTrustPenalty: 3
  solvedIncidentNaughtinessBoost: 5
  monkeysAddedPerSolvedIncident: 2
  postZoolagWaveSeconds: 3
  randomizeSeedEachRun: 1
  fixedSeed: 1729
  incidentPool:
  - type: 0
    alertTitle: AUX CORD MISSING
    description: The aux cord has been stolen. The enclosure music cuts out.
    objectName: aux cord
    effectDescription: "MUSIC OFFLINE \u2014 the daycare has gone quiet."
    blocksCameraEvidence: 0
    incidentSprite: {fileID: 21300000, guid: 0ee19acb68fc3e22c82a5cc4c3d20621, type: 3}
    incidentOffsetMinimum: {x: 0, y: 0}
    incidentOffsetMaximum: {x: 0, y: 0}
  - type: 1
    alertTitle: GENERATOR UNPLUGGED
    description: Somebody unplugged the generator. The enclosure lights go out.
    objectName: generator plug
    effectDescription: "LIGHTS OUT \u2014 the feeds are now much harder to read."
    blocksCameraEvidence: 1
    incidentSprite: {fileID: 21300000, guid: a318f9b29d5726e47b0ff02899bb3251, type: 3}
    incidentOffsetMinimum: {x: 0, y: 0}
    incidentOffsetMaximum: {x: 0, y: 0}
  - type: 2
    alertTitle: SURVEILLANCE CONSOLE TAMPERED WITH
    description: A monkey has messed with the surveillance console.
    objectName: surveillance console
    effectDescription: "CAMERA INTERFERENCE \u2014 the feed jitters and no recording
      was saved."
    blocksCameraEvidence: 1
    incidentSprite: {fileID: 21300000, guid: 1ed4b618ad2caf80bb5412dc2104b41b, type: 3}
    incidentOffsetMinimum: {x: 0, y: 0}
    incidentOffsetMaximum: {x: 0, y: 0}
  - type: 3
    alertTitle: BANANA STASH RAIDED
    description: Somebody raided the banana stash.
    objectName: banana stash
    effectDescription: "FOOD LOW \u2014 the remaining monkeys will become more restless."
    blocksCameraEvidence: 0
    incidentSprite: {fileID: 21300000, guid: ba2aca09cd317f097aaa31d1b2373ab5, type: 3}
    incidentOffsetMinimum: {x: 0, y: 0}
    incidentOffsetMaximum: {x: 0, y: 0}
  - type: 5
    alertTitle: GIANT MESS DISCOVERED
    description: Somebody left an enormous mess in the enclosure.
    objectName: giant mess
    effectDescription: "BIG MESS \u2014 this room needs cleaning."
    blocksCameraEvidence: 0
    incidentSprite: {fileID: 21300000, guid: 525fad2ba084ea5ef9ba1443ac976c4a, type: 3}
    incidentOffsetMinimum: {x: 0, y: 0}
    incidentOffsetMaximum: {x: 0, y: 0}
  zones:
